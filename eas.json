{
  "cli": { "version": ">= 13.2.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development", "NPM_CONFIG_LEGACY_PEER_DEPS": "true" }
    },
    "staging": { "distribution": "internal", "env": { "APP_VARIANT": "staging" } },
    "production": {
      "distribution": "store",
      "channel": "production",
      "ios": { "autoIncrement": true },
      "env": { "APP_VARIANT": "production", "NPM_CONFIG_LEGACY_PEER_DEPS": "true", "EXPO_PUBLIC_API_URL_PRODUCTION": "https://api.humanscale.app", "APP_VERSION": "1.0.0" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "production", "NPM_CONFIG_LEGACY_PEER_DEPS": "true", "EXPO_PUBLIC_API_URL_PRODUCTION": "https://api.humanscale.app", "APP_VERSION": "1.0.0" }
    }
  },
  "submit": { "production": {} }
}
