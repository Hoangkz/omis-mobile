# Môi trường chạy: development | staging | production
APP_VARIANT=development
APP_VERSION=1.0.0

# URL API theo môi trường (app tự chọn theo APP_VARIANT)
EXPO_PUBLIC_API_URL_DEV=http://localhost:3001
EXPO_PUBLIC_API_URL_STAGING=https://api-staging.example.com
EXPO_PUBLIC_API_URL_PRODUCTION=https://api.example.com

# Chỉ dùng cho `npm run start` (scripts/start.js)
EXPO_NO_TELEMETRY=1
# Địa chỉ adb của máy ảo MEmu (mặc định 127.0.0.1:21503)
EMULATOR_ADDR=127.0.0.1:21503
